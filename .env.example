# Required for production
DATABASE_URL=postgresql://...
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
APP_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=true

# Optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SignalWire (voice & SMS for AI guest assistant)
# Get these from your SignalWire dashboard: https://start.signalwire.com
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SPACE_URL=yourspace.signalwire.com
SIGNALWIRE_PHONE=+12025550100

# Stripe (per-booking guest payments)
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret from Stripe Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Public URL used for Checkout success/cancel redirects (overrides Railway auto-detection)
APP_BASE_URL=

# Per-service booking prices (USD)
STRIPE_PRICE_TURNOVER=120.00
STRIPE_PRICE_DEEP=200.00
STRIPE_PRICE_LINEN=50.00
STRIPE_PRICE_INSPECTION=75.00