# Required for production
DATABASE_URL=postgresql://...
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
# OTP is emailed to ADMIN_EMAIL; override the recipient (e.g. a shared inbox)
ADMIN_OTP_EMAIL=
ADMIN_NAME=Owner
APP_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=true
# Set "false" only to skip email codes during local dev
OTP_ENABLED=true

# Optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Booking timezone and slot length used by the AI assistant (defaults America/New_York, 1h)
APP_TIMEZONE=America/New_York
BOOKING_HOURS=1

# SignalWire (voice & SMS for AI guest assistant)
# Get these from your SignalWire dashboard: https://start.signalwire.com
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SPACE_URL=yourspace.signalwire.com
SIGNALWIRE_PHONE=+12025550100

# Stripe (per-booking guest payments)
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret from Stripe Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Public URL used for Checkout success/cancel redirects (overrides Railway auto-detection)
APP_BASE_URL=

# LinkedIn Lead Radar (Apify)
# Get your token at https://console.apify.com/account/integrations
APIFY_TOKEN=

# Free rental analysis (real property + area market data)
# Grab a free API key at https://www.realestateapi.com (Header: x-api-key)
REALESTATE_API_KEY=

# Per-service booking prices (USD)
STRIPE_PRICE_TURNOVER=120.00
STRIPE_PRICE_DEEP=200.00
STRIPE_PRICE_LINEN=50.00
STRIPE_PRICE_INSPECTION=75.00

# Document delivery — SMTP (also required for OTP login codes sent by email)
# Every role (admin, host, employee) must have an email address on file to sign in.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@bizstackperks.com
SMTP_NAME=BizStack Hosts
# true (STARTTLS), false (no encryption), or ssl (implicit TLS on 465)
SMTP_TLS=true

# Printable payroll checks (bank details printed on check + stub)
CHECK_HOLDER=BizStack Hosts
CHECK_HOLDER_ADDRESS=
CHECK_CITY_STATE_ZIP=
CHECK_ROUTING=000000000
CHECK_ACCOUNT=000000000000
CHECK_START_NUMBER=1001